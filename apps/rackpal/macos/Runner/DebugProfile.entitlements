<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DR-256: no App Sandbox, so app-sandbox and network.server (sandbox-only) are
	     gone. allow-jit stays: the debug Dart VM JITs, and the hardened runtime
	     forbids that without it. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>

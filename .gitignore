# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.dill
*.snapshot
.flutter-plugins
.flutter-plugins-dependencies
# The ROOT pubspec.lock is committed (DR-248 §11.247.5): the workspace resolves
# once, there, and a cooldown the lockfile does not record holds nowhere else.
# A member's own lockfile would be a stray from resolving outside the workspace.
/apps/**/pubspec.lock
/packages/**/pubspec.lock

# Generated code (build_runner)
*.g.dart
*.freezed.dart
*.mocks.dart

# Platform build output
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
macos/Pods/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/


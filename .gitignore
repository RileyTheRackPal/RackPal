# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.dill
*.snapshot
.flutter-plugins
.flutter-plugins-dependencies
# The ROOT pubspec.lock is committed (DR-248 §11.247.5): the workspace resolves
# once, there, and a cooldown the lockfile does not record holds nowhere else.
# A member's own lockfile would be a stray from resolving outside the workspace.
/apps/**/pubspec.lock
/packages/**/pubspec.lock

# Generated code (build_runner)
*.g.dart
*.freezed.dart
*.mocks.dart

# Platform build output
android/.gradle/
android/app/debug/
android/app/profile/
android/app/release/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
macos/Pods/
macos/Flutter/ephemeral/
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test output
coverage/
test/**/failures/

# App artifacts
*.rackpal.bak
*.rackpal.autosave

# Release staging (tools/release/make_portable.ps1)
dist/

# SIGNING KEY MATERIAL -- NEVER COMMIT ANY OF THIS.
# DR-006 self-signs, which makes the private key cheap to re-mint and
# therefore tempting to check in "just for the build agent". Do not. A
# committed key is a key every clone can sign as, and a self-signed
# publisher the org has told its machines to TRUST (LocalMachine\
# TrustedPublisher) is exactly the certificate you least want loose.
# The public .cer is the half that gets distributed, and it is deployed by
# GPO rather than from this repository.
*.pfx
*.p12
*.snk
*.key

# Python (tools/)
__pycache__/
*.pyc

# ═══════════════════════════════════════════════════════════════════════
# REAL CLIENT DRAWINGS ARE NEVER COMMITTED, AND GIT IS WHY
# ═══════════════════════════════════════════════════════════════════════
# `docs/reference/` holds text records of reference material, never the
# material itself. A real job's plan set carries a licensed engineer's
# seal and licence number, the firm's name, the builder's mark and a
# client's address, and a redaction that covers the address does not
# cover any of the rest. Vendor photographs and drawings are somebody
# else's copyright: DR-259 removed 73 of them from every commit before
# the source went public, and the keystone README records what they said.
#
# THE REASON IS THAT GIT HISTORY IS PERMANENT. A public AGPL repository
# publishes every commit ever made, not the current tree, so a file
# committed today and deleted tomorrow ships anyway. Nothing in this
# product needs one in the repository: the measurements taken from a plan
# set are recorded in docs/12 with the method beside them, so anybody can
# re-run them against their own sheet (docs/12 section 5.9.5).
#
# So everything under docs/reference/ that is not markdown is ignored, at
# any depth. A file that genuinely belongs needs a negation here, which is
# a diff somebody reads.
docs/reference/**/*
!docs/reference/**/
!docs/reference/**/*.md

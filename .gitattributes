# Normalize to LF in the repository; check out native on Windows.
* text=auto

*.dart   text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.ps1    text eol=crlf
*.bat    text eol=crlf

*.png    binary
*.jpg    binary
*.ttf    binary
*.otf    binary
*.pdf    binary
